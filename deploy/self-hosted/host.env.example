# Copy to /etc/tandem/host.env with mode 0600; replace every placeholder.
# Never commit the completed file. Back it up outside the Tandem host.
TANDEM_ADMIN_TOKEN=REPLACE_WITH_A_STABLE_RANDOM_SECRET
TANDEM_BUCKET=s3://YOUR_BUCKET/tandem
AWS_ENDPOINT=https://YOUR_S3_ENDPOINT
AWS_REGION=YOUR_BUCKET_REGION
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
TANDEM_PUBLIC_URL=https://tandem.example
TANDEM_DISTRIBUTION_DIR=/opt/tandem/dist
